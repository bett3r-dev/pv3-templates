{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "build/cjs",
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "sourceMap": true,
    "composite": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [ "src/**/*" ],
  "exclude": [ "**/*.test.ts", "build" ]
}
